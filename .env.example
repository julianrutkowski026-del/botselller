# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ATTACHMENTS_BUCKET=campaign-attachments
SUPABASE_ORDER_ATTACHMENTS_BUCKET=

# Application security and admin access
SECRET_ENCRYPTION_KEY=
CLIENT_PORTAL_SECRET=
ADMIN_EMAILS=
CRON_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Lead discovery and email generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
GOOGLE_PLACES_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
GOOGLE_SEARCH_ENGINE_ID=
LEAD_SEARCH_PAIRS_PER_CYCLE=12
LEAD_SEARCH_RESULTS_PER_QUERY=10
LEAD_SEARCH_PLACE_BUDGET=80
LEAD_SEARCH_MAX_SECONDS=45
UNDER_TARGET_RETRY_MINUTES=3

# Optional shared SMTP and inbox checking credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
IMAP_HOST=
IMAP_PORT=993
INBOX_CHECKER_ENABLED=true
INBOX_CHECKER_LOOKBACK_DAYS=14

# Sending safeguards
SEND_WORKER_BATCH_SIZE=1
SEND_QUEUE_MAX_ATTEMPTS=3
SEND_QUEUE_STALE_LOCK_MINUTES=15
SIGNUP_ORDER_CLEANUP_HOURS=48
REPUTATION_MIN_SAMPLE=20
REPUTATION_MAX_BOUNCE_RATE=8
REPUTATION_MAX_SPAM_RATE=1
REPUTATION_MAX_FAILED_RATE=25

# Optional global send limits; zero disables each cap
APP_MAX_ACTIVE_CAMPAIGNS=0
APP_MAX_DAILY_EMAILS=0
APP_MAX_MONTHLY_EMAILS=0
APP_MAX_PENDING_QUEUE=0
APP_MAX_FAILED_QUEUE=0

# Optional email event webhook authentication
EMAIL_EVENTS_SECRET=
POSTMARK_WEBHOOK_TOKEN=
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_API_KEY=
SENDGRID_WEBHOOK_SECRET=

# Optional credentials used by the admin secrets store
TWILIO_AUTH_TOKEN=
